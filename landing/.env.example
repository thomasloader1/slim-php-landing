# Conexión a MySQL (DB maestra - project_landing)
DB_HOST=phpmyadmin-mysql
DB_PORT=3306
DB_NAME=project_landing
DB_USER=landing_user
DB_PASS=landing_pass

# Entorno: production | development
APP_ENV=development

# Ruta base si la app NO está en la raíz del dominio
# Ej: si la app está en misitio.com/landing → APP_BASE_PATH=/landing
# Dejar vacío si está en la raíz del dominio
APP_BASE_PATH=

# Multitenant: Clave maestra para cifrar db_pass_encrypted de cada site
# REQUERIDA en producción - generar con: openssl rand -base64 32
TENANT_ENCRYPTION_KEY=

# Multitenant: Clave nueva para rotación (opcional)
TENANT_ENCRYPTION_KEY_V2=

# Multitenant: Identificador de la clave activa (v1 o v2)
TENANT_ENCRYPTION_KEY_ACTIVE=v1

# Multitenant: Ruta al directorio de migraciones por cliente
TENANT_MIGRATIONS_PATH=db/updates

# Multitenant: Plan por defecto para nuevos sites
TENANT_DEFAULT_PLAN=basico

# Multitenant: Habilitar conexiones persistentes por site (0/1)
DB_CONNECTION_POOL=0

# MySQL root password (para el contenedor mysql)
MYSQL_ROOT_PASSWORD=root

# Dominios que sirven la landing principal (DB master) y el panel de superadmin.
# CSV, sin protocolo. localhost siempre está incluido.
# Cualquier otro dominio se resuelve como sitio cliente (tabla `sites`) si el
# módulo site_manager está activo.
MASTER_DOMAINS=localhost
